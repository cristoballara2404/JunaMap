# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.
PORT=3000
DATABASE_URL=postgresql://junamap:cambia_esta_clave@localhost:5432/junamap
COSTO_SERVICIO=250
CORS_ORIGIN=http://localhost:5173
# Secreto para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esto, las sesiones se pierden cada vez que se reinicia el servidor.
JWT_SECRET=
SESION_DIAS=7
# Clave para administrar locales (crear, editar, borrar) con la cabecera x-admin-key.
# Si la dejas vacía, esas operaciones quedan desactivadas.
ADMIN_KEY=
